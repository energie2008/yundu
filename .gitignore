# ============================================
# YunDu .gitignore（物理隔离后的简化版）
# 目录已干净，仅需排除编译产物和敏感配置
# ============================================

# --- 二进制文件 ---
*.exe
*.dll
*.so
*.dylib
*.gz
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# --- 无扩展名二进制（按文件名排除）---
/node-agent
/node-agent-*
/node-service
/node-service-*
/api-gateway
/api-gateway-*
/identity-service
/identity-service-*
/subscription-service
/subscription-service-*
/traffic-service
/traffic-service-*
/migrate
/genkey
/statsprobe
/yunductl

# --- 编译产物目录 ---
**/bin/
**/dist/
**/target/
**/build/
**/out/
**/node_modules/

# --- 敏感配置 ---
.env
.env.*
!.env.example

# --- 日志 ---
*.log
**/logs/

# --- 临时文件 ---
**/tmp/
*.tmp
*.bak
*.bak.*
*.pid
*.seed

# --- 前端构建产物 ---
*.tsbuildinfo

# --- Go ---
vendor/
*.test
*.out

# --- Coverage ---
coverage/
*.lcov
.nyc_output/

# --- IDE / OS ---
.idea/
.vscode/
.trae/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- 本地编译产物（非 CI）---
dist-local/

# --- 临时目录 / 工具残留 ---
.qoder/
.tmp-readme/
.tmp-*/

# --- 子目录编译产物与诊断文件 ---
apps/node-agent/agent
apps/node-agent/node-agent-linux
apps/node-service/node-service-linux
info.json

# --- 本地敏感文档（含密钥/VPS信息，禁止提交）---
文档/
docs-local/
tmp-bin/ 
v2版易支付.txt
200易支付凭据.txt
SDK_2.0.zip
